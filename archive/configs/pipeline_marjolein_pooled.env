# Basic run settings
PROFILE=hpc
RESUME=false
RESET_OUTPUTS=false
RUN_ID=marjolein_pooled_20260414
START_FROM=

# Pipeline code root
PIPELINES_ROOT=/ictstr01/groups/idc/projects/uhlenhaut/jiang/pipelines

# This project
PROJECT_ROOT=/ictstr01/groups/idc/projects/uhlenhaut/jiang/pipelines/chip_runs/marjolein/X208SC26034859-Z01-F001

# Unified output root for this project
OUTPUT_PROJECT_ROOT=${PROJECT_ROOT}/runs

# Sample metadata
SAMPLES_MASTER=${PROJECT_ROOT}/samples_master_pooled.csv

# Reference / annotation
REFERENCE_ROOT=/ictstr01/groups/idc/projects/uhlenhaut/jiang/reference
GENOME_RELEASE=GRCm39
GENCODE_VERSION=vM27
REFERENCE_FASTA=${REFERENCE_ROOT}/bwa/${GENOME_RELEASE}_${GENCODE_VERSION}/GRCm39.primary_assembly.genome.fa
GTF=${REFERENCE_ROOT}/gtf/gencode.${GENCODE_VERSION}.primary_assembly.annotation.gtf

# Core analysis thresholds
MAPQ_THRESHOLD=24

MACS3_QVALUE_IDR=0.1
MACS3_QVALUE_CONSENSUS=0.05
MACS3_QVALUE_STRICT=0.01

# For pooled samples:
# run standard sample-level QC + alignment + filtering + peak calling + bigWig
MACS3_RUN_IDR_BRANCH=true
MACS3_RUN_CONSENSUS_BRANCH=true
MACS3_RUN_STRICT_BRANCH=true

# Optional explicit sheets
MACS3_SAMPLESHEET=
IDR_PAIRS_CSV=
DIFFBIND_SAMPLESHEET=
FRIP_SAMPLESHEET=
DEEPTOOLS_REGIONS_SHEET=
HOMER_MOTIF_COMPARE_SHEET=
CONSENSUS_PAIRS_CSV=

# Optional peak-source overrides
FRIP_PEAK_SOURCES=
CHIPSEEKER_PEAK_SOURCES=
HOMER_PEAK_SOURCES=

# Module toggles
RUN_FASTQC=true
RUN_FASTP=true
RUN_BWA=true
RUN_PICARD=true
RUN_CHIPFILTER=true
RUN_MACS3=true
RUN_IDR=false
RUN_PEAK_CONSENSUS=false
RUN_DIFFBIND=false

RUN_BAMCOVERAGE=true
RUN_FRIP=false
RUN_CHIPSEEKER=false
RUN_HOMER=false
RUN_HOMER_MOTIF_COMPARE=false
RUN_DEEPTOOLS_HEATMAP=false

RUN_RESULT_DELIVERY=false
RUN_MULTIQC=true

# Result delivery
DELIVERY_TAG=
DELIVERY_LEVEL=lean

# MultiQC
MULTIQC_TITLE='Marjolein pooled ChIP-seq Summary'
MULTIQC_REPORT_NAME=multiqc_report.html
MULTIQC_EXTRA_PATHS=
MULTIQC_CONFIG=
