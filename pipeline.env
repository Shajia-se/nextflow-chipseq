# Standard mouse paired-end workflow with the shared liver Input 25L007941.
# Edit RUN_ID, RUNNER, email and samples_master.csv for each new run.
# MACS3 calls each sample independently at q=0.05 and q=0.01; no replicate merging.

# Run settings
PROFILE=hpc
HPC_MAIL_USER=shan.jiang@helmholtz-munich.de
RUNNER=marjolein
RUN_ID=20260914_marjolein
RESUME=true
RESET_OUTPUTS=false
START_FROM=
PIPELINES_ROOT=/ictstr01/groups/idc/projects/uhlenhaut/jiang/pipelines
CHIP_RUNS_ROOT=${PIPELINES_ROOT}/chip_runs

# Run-local sample sheets. Keep sample_id consistent across all three CSV files.
SAMPLES_MASTER=${CHIP_RUNS_ROOT}/${RUN_ID}/samples_master.csv
MACS3_SAMPLESHEET=${CHIP_RUNS_ROOT}/${RUN_ID}/macs3_samplesheet.csv
SHARED_CONTROL_MANIFEST=${CHIP_RUNS_ROOT}/${RUN_ID}/shared_control_manifest.csv
NEXTFLOW_CONFIG=${CHIP_RUNS_ROOT}/${RUN_ID}/external_input.config

# Fixed reference: mouse GRCm39 / GENCODE vM27
REFERENCE_ROOT=/ictstr01/groups/idc/projects/uhlenhaut/jiang/reference
GENOME_RELEASE=GRCm39
GENCODE_VERSION=vM27
REFERENCE_FASTA=${REFERENCE_ROOT}/bwa/${GENOME_RELEASE}_${GENCODE_VERSION}/GRCm39.primary_assembly.genome.fa
GTF=${REFERENCE_ROOT}/gtf/gencode.vM27.primary_assembly.annotation.gtf

# Fixed shared Input (documentation; actual MACS3 BAM selection is in the CSV).
# Do not add this Input to samples_master.csv: its upstream processing is complete.
# Both CSV templates and external_input.config use this same directory.
# Input ID: 25L007941
# Input root: /ictstr01/groups/idc/projects/uhlenhaut/jiang/pipelines/chip_runs/shared_input/liver/25L007941
# Input BAM: chipfilter_output/25L007941.nomulti.bam

# Filtering and peak calling
MAPQ_THRESHOLD=24
MACS3_QVALUE_CONSENSUS=0.05
MACS3_QVALUE_STRICT=0.01
MACS3_RUN_CONSENSUS_BRANCH=true
MACS3_RUN_STRICT_BRANCH=true
MACS3_RUN_IDR_BRANCH=false
MACS3_PEAK_BLACKLIST_BED=

# Standard analysis: keep these enabled for the complete sample-level workflow.
RUN_FASTQC=true
RUN_FASTP=true
RUN_BWA=true
RUN_PICARD=true
RUN_CHIPFILTER=true
RUN_MACS3=true
RUN_BAMCOVERAGE=true
RUN_MULTIQC=true
RUN_RESULT_DELIVERY=true

# Not used in this workflow; false must remain explicit.
# Automatic FRiP currently requires IDR/consensus outputs or a separate FRiP sheet.
RUN_FRIP=false
RUN_IDR=false
RUN_PEAK_CONSENSUS=false
RUN_DIFFBIND=false
RUN_CHIPSEEKER=false
RUN_HOMER=false
RUN_DEEPTOOLS_HEATMAP=false

# Delivery
DELIVERY_LEVEL=lean
DELIVERY_TAG=
MULTIQC_TITLE='ChIP-seq Pipeline Summary'
MULTIQC_REPORT_NAME=multiqc_report.html
# For all other options, see archive/configs/pipeline.advanced.env.example.
